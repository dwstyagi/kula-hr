<%= render "shared/public_page_meta",
      title: "Free PF, ESI & CTC Take-Home Calculators | Kula HR",
      description: "Estimate Indian PF, ESI and monthly take-home from annual CTC with visible assumptions and links to official government sources.",
      canonical_path: payroll_calculators_path,
      schema_type: "WebApplication" %>

<%= render "home/landing/styles" %>
<%= render "resources/styles" %>
<%= render "home/landing/nav" %>

<main class="resource-page" data-controller="payroll-calculators" data-action="input->payroll-calculators#calculateAll change->payroll-calculators#calculateAll">
  <%= render "resources/hero",
        parent: "Resources",
        eyebrow: "Payroll calculators",
        headline: "Estimate the deduction—and inspect the assumption.",
        lede: "These calculators use standard PF and ESI settings to create a planning estimate. Every result keeps its rates, ceilings and exclusions visible.",
        stamp: "Standard statutory assumptions · Runs in your browser · No values submitted" %>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl space-y-10 px-6 lg:px-8">
      <section id="pf-calculator" class="resource-paper overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
        <div class="grid lg:grid-cols-[.9fr_1.1fr]">
          <div class="border-b border-stone-200 p-7 sm:p-9 lg:border-r lg:border-b-0">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700">01 / EPF estimate</p>
            <h2 class="mt-5 text-3xl font-bold tracking-tight text-stone-950">PF contribution calculator</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">Enter monthly Basic and Dearness Allowance. The standard estimate uses a 12% employee share and 12% employer share.</p>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <label class="text-sm font-semibold text-stone-700">Monthly Basic
                <input data-payroll-calculators-target="pfBasic" type="number" min="0" step="100" value="30000" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
              </label>
              <label class="text-sm font-semibold text-stone-700">Dearness Allowance
                <input data-payroll-calculators-target="pfDa" type="number" min="0" step="100" value="0" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
              </label>
            </div>
            <label class="mt-6 flex items-start gap-3 text-sm leading-6 text-stone-600">
              <input data-payroll-calculators-target="pfFull" type="checkbox" class="mt-1 size-4 rounded border-stone-300">
              Calculate PF on full entered wages instead of limiting the contribution base to ₹15,000.
            </label>
          </div>
          <div class="bg-white p-7 sm:p-9">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-stone-500">Monthly estimate</p>
            <dl class="mt-6 divide-y divide-stone-200 border-y border-stone-200">
              <% [["PF contribution base", "pfBase"], ["Employee PF", "pfEmployee"], ["Employer total", "pfEmployer"], ["Employer EPS allocation", "pfEps"], ["Employer EPF balance", "pfEpf"]].each do |label, target| %>
                <div class="flex items-center justify-between gap-6 py-4">
                  <dt class="text-sm text-stone-600"><%= label %></dt>
                  <dd data-payroll-calculators-target="<%= target %>" class="font-mono text-base font-semibold text-stone-950">₹0</dd>
                </div>
              <% end %>
            </dl>
            <p class="mt-5 text-xs leading-6 text-stone-500">EPS is estimated at 8.33% of the capped pensionable wage and rounded to the nearest rupee. Establishment-specific exclusions and voluntary PF are not modelled.</p>
          </div>
        </div>
      </section>

      <section id="esi-calculator" class="resource-paper overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
        <div class="grid lg:grid-cols-[.9fr_1.1fr]">
          <div class="border-b border-stone-200 p-7 sm:p-9 lg:border-r lg:border-b-0">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700">02 / ESI estimate</p>
            <h2 class="mt-5 text-3xl font-bold tracking-tight text-stone-950">ESI contribution calculator</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">The standard estimate applies 0.75% employee and 3.25% employer contributions when monthly wages are within ₹21,000.</p>
            <label class="mt-8 block text-sm font-semibold text-stone-700">Monthly ESI wages
              <input data-payroll-calculators-target="esiGross" type="number" min="0" step="100" value="18000" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
            </label>
            <p data-payroll-calculators-target="esiStatus" class="mt-2 text-xs font-semibold text-kula-700"></p>
          </div>
          <div class="bg-white p-7 sm:p-9">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-stone-500">Monthly estimate</p>
            <dl class="mt-6 divide-y divide-stone-200 border-y border-stone-200">
              <% [["Employee contribution", "esiEmployee"], ["Employer contribution", "esiEmployer"], ["Combined contribution", "esiTotal"]].each do |label, target| %>
                <div class="flex items-center justify-between gap-6 py-5">
                  <dt class="text-sm text-stone-600"><%= label %></dt>
                  <dd data-payroll-calculators-target="<%= target %>" class="font-mono text-base font-semibold text-stone-950">₹0</dd>
                </div>
              <% end %>
            </dl>
            <p class="mt-5 text-xs leading-6 text-stone-500">An employee already covered at the start of a contribution period may remain covered until that period ends even after wages cross the ceiling. Verify the employee’s coverage history.</p>
          </div>
        </div>
      </section>

      <section id="take-home-calculator" class="resource-paper overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
        <div class="grid lg:grid-cols-[.9fr_1.1fr]">
          <div class="border-b border-stone-200 p-7 sm:p-9 lg:border-r lg:border-b-0">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700">03 / CTC estimate</p>
            <h2 class="mt-5 text-3xl font-bold tracking-tight text-stone-950">CTC to take-home calculator</h2>
            <p class="mt-4 text-sm leading-7 text-stone-600">Create an illustrative monthly breakup after employer PF/ESI and employee deductions. Enter PT and TDS because both depend on facts this calculator does not collect.</p>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <label class="text-sm font-semibold text-stone-700 sm:col-span-2">Annual CTC
                <input data-payroll-calculators-target="ctcAnnual" type="number" min="0" step="1000" value="600000" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
              </label>
              <label class="text-sm font-semibold text-stone-700">Basic % of monthly CTC
                <input data-payroll-calculators-target="ctcBasicPercent" type="number" min="0" max="100" step="1" value="40" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950">
              </label>
              <label class="text-sm font-semibold text-stone-700">HRA % of Basic
                <input data-payroll-calculators-target="ctcHraPercent" type="number" min="0" max="100" step="1" value="50" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950">
              </label>
              <label class="text-sm font-semibold text-stone-700">Monthly PT
                <input data-payroll-calculators-target="ctcPt" type="number" min="0" step="50" value="200" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950">
              </label>
              <label class="text-sm font-semibold text-stone-700">Monthly TDS
                <input data-payroll-calculators-target="ctcTds" type="number" min="0" step="100" value="0" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950">
              </label>
            </div>
            <label class="mt-6 flex items-start gap-3 text-sm leading-6 text-stone-600">
              <input data-payroll-calculators-target="ctcFullPf" type="checkbox" class="mt-1 size-4 rounded border-stone-300">
              Calculate employer and employee PF on full Basic instead of a ₹15,000 base.
            </label>
          </div>
          <div class="bg-white p-7 sm:p-9">
            <div class="flex items-end justify-between gap-6 border-b-2 border-kula-800 pb-6">
              <div>
                <p class="font-mono text-xs uppercase tracking-[.16em] text-stone-500">Estimated take-home</p>
                <p data-payroll-calculators-target="ctcNet" class="mt-2 text-3xl font-bold tracking-tight text-kula-900">₹0</p>
              </div>
              <p class="text-xs text-stone-500">per month</p>
            </div>
            <dl class="mt-3 divide-y divide-stone-100">
              <% [
                ["Monthly CTC", "ctcMonthly"], ["Basic", "ctcBasic"], ["HRA", "ctcHra"], ["Special allowance", "ctcSpecial"],
                ["Employer PF", "ctcEmployerPf"], ["Employer ESI", "ctcEmployerEsi"], ["Employee PF", "ctcEmployeePf"],
                ["Employee ESI", "ctcEmployeeEsi"], ["Employee deductions incl. entered PT/TDS", "ctcDeductions"]
              ].each do |label, target| %>
                <div class="flex items-center justify-between gap-5 py-3.5">
                  <dt class="text-xs leading-5 text-stone-600"><%= label %></dt>
                  <dd data-payroll-calculators-target="<%= target %>" class="font-mono text-sm font-semibold text-stone-900">₹0</dd>
                </div>
              <% end %>
            </dl>
            <p class="mt-5 text-xs leading-6 text-stone-500">This simplified model excludes gratuity, bonus, insurance, reimbursements, perquisites and income-tax computation. It is not an offer-letter or payslip calculation.</p>
          </div>
        </div>
      </section>

      <div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
        <%= render "resources/review_note", reviewed: @last_reviewed, text: "These are planning estimates, not legal, tax or payroll advice. Confirm coverage, wage definitions, rounding and organisation-specific settings before using any result." %>
        <aside class="rounded-2xl border border-stone-200 bg-stone-50 p-6">
          <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">Official sources</p>
          <ul class="mt-4 space-y-3 text-sm">
            <% @official_sources.each_value do |source| %>
              <li><a href="<%= source[:url] %>" target="_blank" rel="noopener noreferrer" class="font-semibold text-kula-800 underline decoration-kula-300 underline-offset-4"><%= source[:label] %></a></li>
            <% end %>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</main>

<%= render "home/landing/footer" %>
<%= render "marketing_pages/scripts" %>
