<%= render "shared/public_page_meta",
      title: "Free Indian Payroll Calculators — PF, ESI & CTC | Kula HR",
      description: "Free payroll calculators for India: estimate EPF contributions, ESI eligibility and contribution, and monthly in-hand salary from annual CTC.",
      canonical_path: payroll_calculators_path,
      schema_type: "CollectionPage" %>

<%= render "home/landing/styles" %>
<%= render "resources/styles" %>
<%= render "home/landing/nav" %>

<main class="resource-page">
  <%= render "resources/hero",
        parent: "Resources",
        eyebrow: "Payroll calculators",
        headline: "Estimate the deduction—and inspect the assumption.",
        lede: "Each calculator uses standard statutory settings to create a planning estimate, and keeps its rates, ceilings and exclusions visible alongside the result.",
        stamp: "Standard statutory assumptions · Runs in your browser · No values submitted" %>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl space-y-10 px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-3">
        <% [
          [ pf_calculator_path, "01 / EPF", "PF calculator",
            "Enter monthly Basic and DA to estimate employee PF, employer PF, and the employer's split between EPF and the pension scheme — including the ₹15,000 wage ceiling." ],
          [ esi_calculator_path, "02 / ESI", "ESI calculator",
            "Check whether monthly wages fall within the ₹21,000 ceiling, then estimate the 0.75% employee and 3.25% employer contribution." ],
          [ ctc_calculator_path, "03 / CTC", "CTC to in-hand calculator",
            "Turn an annual CTC figure into an illustrative monthly breakup — Basic, HRA, special allowance, employer and employee contributions, and estimated take-home." ]
        ].each do |path, kicker, title, body| %>
          <a href="<%= path %>" class="group resource-paper flex flex-col rounded-2xl border border-stone-200 bg-stone-50 p-8 transition hover:-translate-y-1 hover:border-kula-300 hover:bg-white">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700"><%= kicker %></p>
            <h2 class="mt-8 text-2xl font-bold tracking-tight text-stone-950 group-hover:text-kula-800"><%= title %></h2>
            <p class="mt-4 grow text-sm leading-7 text-stone-600"><%= body %></p>
            <p class="mt-8 text-sm font-semibold text-kula-700">Open calculator <span aria-hidden="true">→</span></p>
          </a>
        <% end %>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-stone-50 p-7 sm:p-9">
        <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">Understand the whole month</p>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-stone-600">Individual deductions are only part of a payroll month. The complete guide walks through the full sequence — freezing the employee master, locking attendance, calculating gross, applying all four statutory deductions, reviewing net pay, paying salaries and depositing dues.</p>
        <a href="<%= blog_post_path("payroll-processing-india") %>" class="mt-5 inline-block text-sm font-semibold text-kula-700 hover:text-kula-900">Read the payroll processing guide <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
        <%= render "resources/review_note", reviewed: @last_reviewed, text: "These are planning estimates, not legal, tax or payroll advice. Confirm coverage, wage definitions, rounding and organisation-specific settings before using any result." %>
        <aside class="rounded-2xl border border-stone-200 bg-stone-50 p-6">
          <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">Official sources</p>
          <ul class="mt-4 space-y-3 text-sm">
            <% @official_sources.each_value do |source| %>
              <li><a href="<%= source[:url] %>" target="_blank" rel="noopener noreferrer" class="font-semibold text-kula-800 underline decoration-kula-300 underline-offset-4"><%= source[:label] %></a></li>
            <% end %>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</main>

<%= render "home/landing/footer" %>
<%= render "marketing_pages/scripts" %>
