<section id="pf-calculator" class="resource-paper overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
  <div class="grid lg:grid-cols-[.9fr_1.1fr]">
    <div class="border-b border-stone-200 p-7 sm:p-9 lg:border-r lg:border-b-0">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700">EPF estimate</p>
      <h2 class="mt-5 text-2xl font-bold tracking-tight text-stone-950">Enter monthly wages</h2>
      <p class="mt-4 text-sm leading-7 text-stone-600">Enter monthly Basic and Dearness Allowance. The standard estimate uses a 12% employee share and 12% employer share.</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <label class="text-sm font-semibold text-stone-700">Monthly Basic
          <input data-payroll-calculators-target="pfBasic" type="number" min="0" step="100" value="30000" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
        </label>
        <label class="text-sm font-semibold text-stone-700">Dearness Allowance
          <input data-payroll-calculators-target="pfDa" type="number" min="0" step="100" value="0" class="mt-2 w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-950 focus:border-kula-600 focus:outline-none focus:ring-2 focus:ring-kula-100">
        </label>
      </div>
      <label class="mt-6 flex items-start gap-3 text-sm leading-6 text-stone-600">
        <input data-payroll-calculators-target="pfFull" type="checkbox" class="mt-1 size-4 rounded border-stone-300">
        Calculate PF on full entered wages instead of limiting the contribution base to ₹15,000.
      </label>
    </div>
    <div class="bg-white p-7 sm:p-9">
      <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-stone-500">Monthly estimate</p>
      <dl class="mt-6 divide-y divide-stone-200 border-y border-stone-200">
        <% [["PF contribution base", "pfBase"], ["Employee PF", "pfEmployee"], ["Employer total", "pfEmployer"], ["Employer EPS allocation", "pfEps"], ["Employer EPF balance", "pfEpf"]].each do |label, target| %>
          <div class="flex items-center justify-between gap-6 py-4">
            <dt class="text-sm text-stone-600"><%= label %></dt>
            <dd data-payroll-calculators-target="<%= target %>" class="font-mono text-base font-semibold text-stone-950">₹0</dd>
          </div>
        <% end %>
      </dl>
      <p class="mt-5 text-xs leading-6 text-stone-500">EPS is estimated at 8.33% of the capped pensionable wage and rounded to the nearest rupee. Establishment-specific exclusions and voluntary PF are not modelled.</p>
    </div>
  </div>
</section>
