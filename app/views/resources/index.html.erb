<%= render "shared/public_page_meta",
      title: "Free Indian Payroll Resources & Calculators | Kula HR",
      description: "Use free PF, ESI and take-home calculators, an Indian payroll compliance calendar, payroll checklist and downloadable payroll templates.",
      canonical_path: resources_path,
      schema_type: "CollectionPage" %>

<%= render "home/landing/styles" %>
<%= render "resources/styles" %>
<%= render "home/landing/nav" %>

<main class="resource-page">
  <%= render "resources/hero",
        eyebrow: "Free payroll resources",
        headline: "Working papers for a cleaner payroll month.",
        lede: "Estimate statutory contributions, plan recurring deadlines, run a repeatable payroll review and start with structured templates—without creating an account.",
        stamp: "Free to use · No email gate · India-specific" %>

  <section class="bg-white py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        <% [
          [payroll_calculators_path, "01 / Calculate", "PF, ESI & CTC calculators", "See the assumptions and estimate employee deductions, employer contributions and monthly take-home."],
          [payroll_compliance_calendar_path, "02 / Plan", "Payroll compliance calendar", "Keep the recurring EPF, ESI and salary-TDS dates for tax year 2026–27 in one practical view."],
          [payroll_checklist_path, "03 / Review", "Financial-year payroll checklist", "Work through setup, input checks, calculation review, payment, filing and employee publishing."],
          [professional_tax_guide_path, "04 / Verify", "State-wise Professional Tax guide", "Understand Kula HR's supported states and jump to each official state source before processing." ]
        ].each do |path, kicker, title, body| %>
          <a href="<%= path %>" class="group resource-paper rounded-2xl border border-stone-200 bg-stone-50 p-8 transition hover:-translate-y-1 hover:border-kula-300 hover:bg-white">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700"><%= kicker %></p>
            <h2 class="mt-8 text-2xl font-bold tracking-tight text-stone-950 group-hover:text-kula-800"><%= title %></h2>
            <p class="mt-4 max-w-xl text-sm leading-7 text-stone-600"><%= body %></p>
            <p class="mt-8 text-sm font-semibold text-kula-700">Open resource <span aria-hidden="true">→</span></p>
          </a>
        <% end %>
      </div>
    </div>
  </section>

  <section class="border-y border-stone-200 bg-stone-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-kula-700">Downloadable templates</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-stone-950">Start with fields that reconcile.</h2>
        <p class="mt-5 text-base leading-7 text-stone-600">Both Excel workbooks include instructions, example rows, formulas and visible input areas. Review the statutory assumptions before using them for live payroll.</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <article class="resource-paper rounded-2xl border border-stone-200 bg-white p-8">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[.18em] text-marigold-800">XLSX · formula-driven</p>
              <h3 class="mt-4 text-xl font-bold text-stone-950">Monthly payroll worksheet</h3>
            </div>
            <span class="rounded-lg bg-kula-50 px-3 py-2 font-mono text-xs font-semibold text-kula-800">PAY</span>
          </div>
          <p class="mt-4 text-sm leading-7 text-stone-600">Capture employee identifiers, earnings, paid days, PF and ESI choices, and manual PT/TDS; formula columns calculate gross, deductions and net pay.</p>
          <a href="/downloads/kula-hr-monthly-payroll-template.xlsx" download class="mt-7 inline-flex rounded-xl bg-kula-800 px-5 py-3 text-sm font-semibold text-white hover:bg-kula-900">Download payroll template</a>
        </article>
        <article class="resource-paper rounded-2xl border border-stone-200 bg-white p-8">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="font-mono text-[10px] font-semibold uppercase tracking-[.18em] text-marigold-800">XLSX · payroll-ready</p>
              <h3 class="mt-4 text-xl font-bold text-stone-950">Monthly attendance worksheet</h3>
            </div>
            <span class="rounded-lg bg-kula-50 px-3 py-2 font-mono text-xs font-semibold text-kula-800">ATT</span>
          </div>
          <p class="mt-4 text-sm leading-7 text-stone-600">Track working days, present days, approved leave, half-days and LOP with a reconciliation check before payroll lock.</p>
          <a href="/downloads/kula-hr-monthly-attendance-template.xlsx" download class="mt-7 inline-flex rounded-xl bg-kula-800 px-5 py-3 text-sm font-semibold text-white hover:bg-kula-900">Download attendance template</a>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-kula-950 py-16 text-white sm:py-20">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-8 px-6 lg:flex-row lg:items-center lg:px-8">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-marigold-300">Move beyond the workbook</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Use the same review discipline inside Kula HR.</h2>
      </div>
      <a href="<%= signup_path %>" class="shrink-0 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-kula-950 hover:bg-kula-50">Start a free payroll run</a>
    </div>
  </section>
</main>

<%= render "home/landing/footer" %>
<%= render "marketing_pages/scripts" %>
