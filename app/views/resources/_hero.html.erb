<section class="resource-grid border-b border-stone-200 pt-32 pb-16 sm:pt-40 sm:pb-20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-xs font-medium text-stone-500">
      <a href="<%= root_path %>" class="hover:text-kula-700">Kula HR</a>
      <span aria-hidden="true">/</span>
      <% if local_assigns[:parent] %>
        <a href="<%= resources_path %>" class="hover:text-kula-700"><%= parent %></a>
        <span aria-hidden="true">/</span>
      <% end %>
      <span class="text-stone-700"><%= eyebrow %></span>
    </nav>
    <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:items-end">
      <div>
        <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-kula-700"><%= eyebrow %></p>
        <h1 class="mt-5 max-w-4xl text-4xl font-bold tracking-[-0.035em] text-stone-950 sm:text-6xl sm:leading-[1.04]"><%= headline %></h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-stone-600"><%= lede %></p>
      </div>
      <% if local_assigns[:stamp] %>
        <div class="resource-paper rotate-1 rounded-xl border border-stone-300 bg-white p-5 font-mono text-xs leading-6 text-stone-600">
          <p class="font-semibold uppercase tracking-[.16em] text-kula-800">Reference note</p>
          <p class="mt-3"><%= stamp %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
