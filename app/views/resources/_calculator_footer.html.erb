<div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
  <%= render "resources/review_note", reviewed: @last_reviewed, text: note %>
  <aside class="rounded-2xl border border-stone-200 bg-stone-50 p-6">
    <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">Official sources</p>
    <ul class="mt-4 space-y-3 text-sm">
      <% @official_sources.each_value do |source| %>
        <li><a href="<%= source[:url] %>" target="_blank" rel="noopener noreferrer" class="font-semibold text-kula-800 underline decoration-kula-300 underline-offset-4"><%= source[:label] %></a></li>
      <% end %>
    </ul>
  </aside>
</div>

<div class="mt-10 rounded-2xl border border-stone-200 bg-stone-50 p-7 sm:p-9">
  <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">More payroll tools</p>
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <% [
      [ pf_calculator_path, "PF calculator", "Employee and employer EPF contribution" ],
      [ esi_calculator_path, "ESI calculator", "Eligibility and contribution split" ],
      [ ctc_calculator_path, "CTC to in-hand calculator", "Monthly take-home from annual CTC" ]
    ].reject { |path, _, _| path == current_tool }.each do |path, label, blurb| %>
      <a href="<%= path %>" class="group rounded-xl border border-stone-200 bg-white p-5 transition hover:border-kula-300">
        <p class="text-sm font-bold text-stone-900 group-hover:text-kula-800"><%= label %></p>
        <p class="mt-2 text-xs leading-6 text-stone-600"><%= blurb %></p>
      </a>
    <% end %>
    <a href="<%= blog_post_path("payroll-processing-india") %>" class="group rounded-xl border border-stone-200 bg-white p-5 transition hover:border-kula-300">
      <p class="text-sm font-bold text-stone-900 group-hover:text-kula-800">Payroll processing guide</p>
      <p class="mt-2 text-xs leading-6 text-stone-600">The full month-end sequence, step by step</p>
    </a>
  </div>
</div>
