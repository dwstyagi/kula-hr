<%= render "shared/public_page_meta",
      title: "Indian Payroll & HR Blog | Kula HR",
      description: "Practical guides on running payroll in India — PF, ESI, Professional Tax, TDS, payslips and month-end process, written for HR and finance teams.",
      canonical_path: blog_path,
      schema_type: "Blog" %>

<%= render "home/landing/styles" %>
<%= render "resources/styles" %>
<%= render "blogs/styles" %>
<%= render "home/landing/nav" %>

<% featured = @posts.first %>
<% rail = @posts.drop(1).first(5) %>
<% categories = @posts.map(&:category).uniq.sort %>

<main class="resource-page" data-controller="blog-filter">

  <%# ── Blog sub-nav ── %>
  <div class="sticky top-0 z-40 border-b border-stone-200 bg-kula-950">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-4 lg:px-8">
      <a href="<%= blog_path %>" class="text-base font-bold tracking-tight text-white">Blog</a>
      <div class="flex flex-wrap items-center gap-x-1 gap-y-2">
        <button type="button" class="blog-tab" aria-pressed="true"
                data-blog-filter-target="tab"
                data-action="blog-filter#select"
                data-blog-filter-category-param="all">All</button>
        <% categories.each do |category| %>
          <button type="button" class="blog-tab" aria-pressed="false"
                  data-blog-filter-target="tab"
                  data-action="blog-filter#select"
                  data-blog-filter-category-param="<%= category %>"><%= category %></button>
        <% end %>
      </div>
    </div>
  </div>

  <% if featured %>
    <%# ── Featured + recent rail ── %>
    <section class="resource-grid border-b border-stone-200 py-14 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:px-8">

        <article>
          <p class="flex flex-wrap items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[.16em] text-stone-500">
            <span class="text-kula-700"><%= featured.category %></span>
            <span aria-hidden="true" class="text-stone-300">|</span>
            <time datetime="<%= featured.published_on.iso8601 %>"><%= featured.published_on.strftime("%-d %b %Y") %></time>
            <span aria-hidden="true" class="text-stone-300">|</span>
            <span><%= featured.reading_minutes %> min read</span>
          </p>

          <h1 class="mt-5 text-3xl font-bold tracking-[-.035em] text-stone-950 sm:text-5xl sm:leading-[1.08]">
            <a href="<%= blog_post_path(featured.slug) %>" class="hover:text-kula-800"><%= featured.title %></a>
          </h1>

          <a href="<%= blog_post_path(featured.slug) %>" class="mt-8 block overflow-hidden rounded-xl">
            <%= render "blogs/cover", post: featured, tall: true %>
          </a>

          <p class="mt-7 max-w-2xl text-base leading-7 text-stone-600"><%= featured.summary %></p>

          <a href="<%= blog_post_path(featured.slug) %>" class="mt-6 inline-block text-sm font-semibold text-kula-700 hover:text-kula-900">
            Read guide <span aria-hidden="true">→</span>
          </a>
        </article>

        <div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[.18em] text-stone-500">Latest</p>
          <div class="mt-5 divide-y divide-stone-200 border-t border-stone-200">
            <% rail.each do |post| %>
              <article class="py-5">
                <p class="flex flex-wrap items-center gap-3 font-mono text-[.7rem] font-semibold uppercase tracking-[.16em] text-stone-500">
                  <span class="text-kula-700"><%= post.category %></span>
                  <span aria-hidden="true" class="text-stone-300">|</span>
                  <time datetime="<%= post.published_on.iso8601 %>"><%= post.published_on.strftime("%-d %b %Y") %></time>
                </p>
                <h2 class="mt-2.5 text-base font-bold leading-6 tracking-tight text-stone-900">
                  <a href="<%= blog_post_path(post.slug) %>" class="hover:text-kula-700"><%= post.title %></a>
                </h2>
              </article>
            <% end %>
          </div>

          <div class="resource-paper mt-8 rounded-2xl border border-stone-200 bg-stone-50 p-6">
            <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-kula-700">Free tools</p>
            <p class="mt-4 text-sm leading-6 text-stone-600">Estimate PF and ESI contributions, or work an annual CTC back to monthly take-home. Every assumption shown, no account needed.</p>
            <div class="mt-5 grid gap-2.5">
              <a href="<%= pf_calculator_path %>" class="text-sm font-semibold text-kula-700 hover:text-kula-900">PF calculator <span aria-hidden="true">→</span></a>
              <a href="<%= esi_calculator_path %>" class="text-sm font-semibold text-kula-700 hover:text-kula-900">ESI calculator <span aria-hidden="true">→</span></a>
              <a href="<%= ctc_calculator_path %>" class="text-sm font-semibold text-kula-700 hover:text-kula-900">CTC to in-hand calculator <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── All guides — every post, including the featured one ── %>
  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-stone-200 pb-5">
        <h2 class="text-2xl font-bold tracking-tight text-stone-950">All guides</h2>
        <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-stone-500"
           data-blog-filter-target="count"><%= pluralize(@posts.size, "article") %></p>
      </div>

      <div class="divide-y divide-stone-200">
        <% @posts.each do |post| %>
          <article class="grid gap-6 py-8 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-8"
                   data-blog-filter-target="item"
                   data-category="<%= post.category %>">
            <a href="<%= blog_post_path(post.slug) %>" class="block overflow-hidden rounded-xl">
              <%= render "blogs/cover", post: post %>
            </a>
            <div>
              <p class="flex flex-wrap items-center gap-3 font-mono text-[.7rem] font-semibold uppercase tracking-[.16em] text-stone-500">
                <span class="text-kula-700"><%= post.category %></span>
                <span aria-hidden="true" class="text-stone-300">|</span>
                <time datetime="<%= post.published_on.iso8601 %>"><%= post.published_on.strftime("%-d %b %Y") %></time>
                <span aria-hidden="true" class="text-stone-300">|</span>
                <span><%= post.reading_minutes %> min</span>
              </p>
              <h3 class="mt-3 text-xl font-bold leading-7 tracking-tight text-stone-950">
                <a href="<%= blog_post_path(post.slug) %>" class="hover:text-kula-700"><%= post.title %></a>
              </h3>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-stone-600"><%= post.summary %></p>
              <a href="<%= blog_post_path(post.slug) %>" class="mt-4 inline-block text-sm font-semibold text-kula-700 hover:text-kula-900">
                Read guide <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        <% end %>
      </div>

      <p class="hidden py-10 text-sm leading-7 text-stone-500" data-blog-filter-target="empty" hidden>
        No guides in this category yet.
      </p>
    </div>
  </section>

  <%= render "home/landing/cta" %>
</main>

<%= render "home/landing/footer" %>
