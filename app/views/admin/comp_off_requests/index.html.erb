<% content_for :page_title, "Comp-off Requests" %>

<div class="max-w-6xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="page-title text-2xl">Comp-off requests</h1>
      <p class="page-sub">Approving credits one comp-off day, valid for <%= Leave::CompOffCreditService::EXPIRY_DAYS %> days.</p>
    </div>
    <%= render "shared/status_tabs", counts: @status_counts,
          statuses: [ [ "All", "" ], [ "Pending", "pending" ], [ "Approved", "approved" ], [ "Rejected", "rejected" ] ],
          path: ->(status) { admin_comp_off_requests_path(status: status) } %>
  </div>

  <%= render "shared/comp_off_requests_table", requests: @comp_off_requests, reviewable: true,
        approve_path: ->(r) { approve_admin_comp_off_request_path(r) },
        reject_path: ->(r) { reject_admin_comp_off_request_path(r) },
        empty_message: "No #{params[:status]} comp-off requests." %>

  <div class="mt-4"><%= render "shared/pagy_nav", pagy: @pagy %></div>
</div>
