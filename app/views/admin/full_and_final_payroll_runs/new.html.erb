<% content_for :page_title, "New Full & Final Settlement" %>

<div class="space-y-6 max-w-3xl">
  <div>
    <h1 class="page-title text-2xl">New Full &amp; Final Settlement</h1>
    <p class="page-sub">Name the run and set the payment date. You will add the employees you are settling on the next screen.</p>
  </div>

  <%= form_with model: @payroll_run, url: admin_full_and_final_payroll_runs_path, class: "space-y-6" do |f| %>
    <% if @payroll_run.errors.any? %>
      <div class="alert alert-error">
        <div>
          <p class="font-semibold">Could not create this run</p>
          <ul class="list-disc list-inside mt-1">
            <% @payroll_run.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="card card-pad grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :title, "Statement label", class: "label" %>
        <%= f.text_field :title, class: "input", required: true, maxlength: 100, placeholder: "Full & Final Settlement" %>
      </div>
      <div>
        <%= f.label :payment_date, class: "label" %>
        <%= f.date_field :payment_date, class: "input", required: true %>
      </div>
      <div class="md:col-span-2">
        <%= f.label :notes, "Internal notes", class: "label" %>
        <%= f.text_area :notes, rows: 2, class: "textarea", placeholder: "Reason or approval reference…" %>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Create and add employees", class: "btn btn-primary cursor-pointer" %>
      <%= link_to "Cancel", admin_off_cycle_payroll_runs_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
