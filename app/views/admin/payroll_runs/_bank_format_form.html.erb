<div class="card overflow-hidden">
  <div class="px-5 py-4 border-b border-stone-100">
    <h2 class="text-sm font-semibold text-stone-900">Bank file</h2>
    <p class="text-xs text-stone-500 mt-0.5">Choose the format accepted by your bank.</p>
  </div>

  <%= form_with url: download_path, method: :get, data: { turbo: false }, class: "p-5" do |f| %>
    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
      <div class="flex-1">
        <%= f.label :bank, "Bank file format", class: "label" %>
        <%= f.select :bank,
              [
                [ "Generic CSV (.csv)", "generic_csv" ],
                [ "HDFC Bank (.txt)", "hdfc" ],
                [ "ICICI Bank (.txt)", "icici" ],
                [ "State Bank of India (.txt)", "sbi" ]
              ],
              {}, class: "select" %>
      </div>

      <%= f.button type: :submit, class: "btn btn-primary cursor-pointer shrink-0 active:scale-[0.97] transition-transform duration-150" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
        </svg>
        Download bank file
      <% end %>
    </div>
  <% end %>
</div>
