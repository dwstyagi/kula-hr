<div class="max-w-6xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="page-title text-2xl">My Team's Comp-off</h1>
      <p class="text-sm text-stone-500 mt-1">Approve comp-off for days your direct reports worked on a weekend or holiday.</p>
    </div>
    <%= render "shared/status_tabs",
          statuses: [ [ "All", "" ], [ "Pending", "pending" ], [ "Approved", "approved" ], [ "Rejected", "rejected" ] ],
          path: ->(status) { employee_portal_team_comp_off_requests_path(status: status) } %>
  </div>

  <%= render "shared/comp_off_requests_table", requests: @comp_off_requests, reviewable: true,
        approve_path: ->(r) { approve_employee_portal_team_comp_off_request_path(r) },
        reject_path: ->(r) { reject_employee_portal_team_comp_off_request_path(r) },
        empty_message: "No #{params[:status]} comp-off requests from your team." %>
</div>
