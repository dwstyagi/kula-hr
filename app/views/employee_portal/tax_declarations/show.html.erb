<% content_for :title, "Tax Declaration — #{@declaration.financial_year}" %>

<div class="max-w-3xl mx-auto">
  <%# ── Header ──────────────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="page-title text-2xl">Tax Declaration</h1>
      <p class="text-sm text-stone-500 mt-0.5">Financial Year <%= @declaration.financial_year %></p>
    </div>

    <div class="flex items-center gap-3">
      <% if @declaration.status_draft? %>
        <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800">Draft</span>
        <%= link_to "Edit Declaration", edit_employee_portal_tax_declaration_path,
            class: "btn btn-secondary" %>
        <%= button_to "Submit Declaration", submit_employee_portal_tax_declaration_path,
            method: :patch,
            class: "btn btn-primary",
            data: { confirm: "Once submitted, you cannot edit this declaration. Continue?" } %>
      <% elsif @declaration.status_submitted? %>
        <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800">Submitted — awaiting HR verification</span>
      <% elsif @declaration.status_verified? %>
        <span class="inline-flex items-center rounded-full bg-kula-100 px-3 py-1 text-xs font-medium text-kula-900">Verified</span>
      <% end %>
    </div>
  </div>

  <%= render "employee_portal/tax_declarations/details", declaration: @declaration %>

  <%# ── TDS Summary placeholder (will be populated by Module 7) ──────────── %>
  <% if @declaration.estimated_monthly_tds.to_f > 0 %>
    <div class="bg-kula-50 border border-kula-200 rounded-lg p-6">
      <h2 class="text-sm font-semibold text-kula-900 uppercase tracking-wide mb-3">Estimated TDS</h2>
      <div class="flex items-center justify-between">
        <span class="text-sm text-kula-800">Monthly TDS deduction</span>
        <span class="text-lg font-bold text-kula-950">₹<%= number_with_delimiter(@declaration.estimated_monthly_tds.to_i) %></span>
      </div>
    </div>
  <% else %>
    <div class="bg-stone-50 border border-stone-200 rounded-lg p-4 text-sm text-stone-500 text-center">
      TDS estimate will be calculated once the declaration is submitted.
    </div>
  <% end %>
</div>
